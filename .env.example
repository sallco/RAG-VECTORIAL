# Credenciales del proveedor compatible con OpenAI (no subir .env real)
OPENAI_API_KEY=
# Para NVIDIA NIM puede usar NVIDIA_API_KEY en lugar de OPENAI_API_KEY.
NVIDIA_API_KEY=
OPENAI_BASE_URL=
MODEL=

# Tu compañero debe proporcionar esta URL y crear/cargar la tabla correspondiente.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parachute
FAQ_TABLE=faqs
EMBEDDING_MODEL=all-MiniLM-L6-v2
